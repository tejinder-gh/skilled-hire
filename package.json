{
  "name": "skilled-hire",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": { "node": ">=22.0.0", "pnpm": ">=10.0.0" },
  "scripts": {
    "predev": "rm -rf apps/*/.next",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test -- --passWithNoTests",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
